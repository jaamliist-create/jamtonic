# --- Supabase ---------------------------------------------------------------
# Local : valeurs affichées par `npx supabase status`.
# Production : Supabase > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (service_role). SERVEUR SEULEMENT : jamais de préfixe NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Application ------------------------------------------------------------
# URL publique du site (sert aux QR codes et aux liens des courriels).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret pour signer l'identifiant anonyme des participants et hacher les adresses réseau.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JT_SECRET=

# --- Facultatif : affichés seulement s'ils sont renseignés -------------------
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_CONTACT_EMAIL=
